# Stripe checkout. Leave empty and the bag shows "checkout not connected yet".
STRIPE_SECRET_KEY=

# Resend newsletter sign-ups (Bad Kitty Club). Both are needed.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Printful private token for the Blazed Kitty store (used by the order sync, coming next).
PRINTFUL_API_TOKEN=
PRINTFUL_STORE_ID=19064428

# Public site URL, used for Stripe success and cancel links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
